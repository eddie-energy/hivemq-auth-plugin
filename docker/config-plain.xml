<?xml version="1.0"?>
<hivemq>
    <listeners>
        <tcp-listener>
            <port>1883</port>
            <bind-address>0.0.0.0</bind-address>
        </tcp-listener>
    </listeners>
    <mqtt>
        <queued-messages>
            <max-queue-size>${HIVEMQ_MAX_QUEUED_MESSAGES}</max-queue-size>
            <strategy>discard-oldest</strategy>
        </queued-messages>
    </mqtt>
    <restrictions>
        <max-connections>${HIVEMQ_MAX_CONNECTIONS}</max-connections>
    </restrictions>
</hivemq>
